# PostgreSQL
POSTGRES_USER=notification
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=notification_development

# Rails DB 接続
DATABASE_URL=postgresql://notification:your_password_here@notification-db/notification_development

# サービス間認証シークレット（backend 側の INTER_SERVICE_SECRET と揃える）
INTER_SERVICE_SECRET=your_secret_here
